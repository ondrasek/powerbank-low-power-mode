# powerbank-lpm configuration — install to /usr/local/etc/powerbank-lpm.conf
# Sourced as bash by the root daemon. Keep it root-owned and 0644.

# Detection mechanism:
#   pd   — use the USB-PD "Unconstrained Power" bit the source advertises.
#          Spec-defined: a source sets it when backed by mains, clears it when
#          backed by a limited internal supply (i.e. a battery). This is the
#          only semantic "am I a power bank" signal macOS exposes.
#   list — ignore PD bits; trust only the fingerprint lists below.
DETECT_MODE="pd"

# Also require the source to advertise Dual-Role Power (it can sink, i.e. it can
# recharge itself) before treating it as a power bank. Stricter; set to 1 if a
# wall charger with sloppy firmware is being misdetected.
REQUIRE_DUAL_ROLE="0"

# Explicit overrides. Get a fingerprint with: powerbank-lpm identify
# One per line. WALL_FINGERPRINTS wins over BANK_FINGERPRINTS, and both win over
# the PD bits — use these when a device's firmware reports the wrong flags.
BANK_FINGERPRINTS="
"
WALL_FINGERPRINTS="
"

# Last-resort fallback, only consulted in list mode. Wattage does NOT reliably
# separate a power bank from a wall charger of the same rating. Leave empty.
BANK_MAX_WATTS=""

# Behaviour with no adapter attached: on | off | ignore (restore prior setting)
ON_BATTERY="ignore"
