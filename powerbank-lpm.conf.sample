# powerbank-lpm configuration — install to /usr/local/etc/powerbank-lpm.conf
# Sourced as bash by the root daemon. Keep it root-owned and 0644.

# --- primary: USB-PD Discover Identity ----------------------------------------
# The source's own vid:pid, lowercase hex, one per line.
# Get it by plugging the source in and running: powerbank-lpm identify
BANK_DEVICES="
"
WALL_DEVICES="
"

# --- fallback: capability fingerprint -----------------------------------------
# For sources that answer no Discover Identity. Hashes the full advertised rail
# set plus PPS range, so two same-wattage sources still differ.
BANK_FINGERPRINTS="
"
WALL_FINGERPRINTS="
"

# --- inferred, off by default -------------------------------------------------
# USB-PD "Unconstrained Power" (bit 27 of the first Fixed PDO) is spec-defined as
# 0 for a battery-backed source. In practice a real 100 W Anker power bank
# reports 1, same as a wall charger, so this is OFF. Enable only if your own
# hardware is honest — check with `powerbank-lpm identify`.
USE_PD_UNCONSTRAINED="0"
# Additionally require Dual-Role Power (source can also sink). Stricter.
REQUIRE_DUAL_ROLE="0"

# Wattage cannot separate a power bank from an equal-rated wall charger.
# Only consulted if nothing above matched. Leave empty.
BANK_MAX_WATTS=""

# Behaviour with no adapter attached: on | off | ignore (restore prior setting)
ON_BATTERY="ignore"
