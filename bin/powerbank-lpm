#!/bin/bash
# powerbank-lpm — toggle macOS Low Power Mode based on which USB-C source is attached.
#
# Runs as root from a LaunchDaemon (pmset writes require root). Event-driven via
# `pmset -g pslog`; no polling.
set -uo pipefail

VERSION="0.2.0"
LABEL="com.ondrasek.powerbank-low-power-mode"
CONFIG="${POWERBANK_LPM_CONFIG:-/usr/local/etc/powerbank-lpm.conf}"
STATE="${POWERBANK_LPM_STATE:-/var/db/powerbank-lpm.state}"

# --- config defaults (overridable in $CONFIG) ---------------------------------
# Primary mechanism: USB-PD Discover Identity vid:pid, one per line, hex.
# Get them from `powerbank-lpm identify`.
BANK_DEVICES=""
WALL_DEVICES=""
# Fallback identity for sources that answer no Discover Identity.
BANK_FINGERPRINTS=""
WALL_FINGERPRINTS=""
# Opt-in: trust the USB-PD Unconstrained Power bit (mains-backed = 1).
# OFF by default - it is spec-defined but real power banks misreport it.
USE_PD_UNCONSTRAINED="0"
# Only consulted alongside the bit above.
REQUIRE_DUAL_ROLE="0"
# Last-resort wattage fallback. Off by default: wattage does NOT distinguish a
# power bank from a wall charger of the same rating.
BANK_MAX_WATTS=""
# Behaviour on the internal battery: on | off | ignore
ON_BATTERY="ignore"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

# --- adapter inspection -------------------------------------------------------

on_ac() { pmset -g batt 2>/dev/null | head -1 | grep -q "AC Power"; }

# Raw AdapterDetails dict, or empty when nothing is attached.
adapter_raw() {
    ioreg -rn AppleSmartBattery -w 0 2>/dev/null |
        sed -n 's/.*"AdapterDetails" = {\(.*\)}.*/\1/p' | head -1
}

# Pull one key out of a dict read on stdin, first match wins.
# Quoted and bare values both occur, e.g. "Watts"=60 and "Description"="pd charger".
# Written in awk deliberately: BSD sed has no \| alternation, so a sed version
# fails silently on macOS and yields an empty field.
adapter_field() {
    awk -v k="\"$1\"=" '
        { i = index($0, k); if (i == 0) exit
          r = substr($0, i + length(k))
          if (substr(r, 1, 1) == "\"") { r = substr(r, 2); print substr(r, 1, index(r, "\"") - 1) }
          else { j = match(r, /[,}]/); print j ? substr(r, 1, j - 1) : r }
          exit }'
}

# --- USB-PD source capabilities ----------------------------------------------
#
# PortControllerPortPDO holds the Source Capabilities the attached source
# advertised. CRITICAL: this array is NOT cleared on unplug — it persists from
# the last negotiation. Select the port by live contract (MaxPower > 0), never by
# "the PDO array is non-zero", or an unplugged charger reads as still attached.

pd_port_line() {
    ioreg -rn AppleSmartBattery -w 0 2>/dev/null | tr '{' '\n' |
        awk '/"PortControllerPortPDO"/ && /"PortControllerMaxPower"=[1-9]/ { print; exit }'
}

pd_pdo_list() {
    printf '%s' "${1:-}" | sed -n 's/.*"PortControllerPortPDO"=(\([^)]*\)).*/\1/p'
}

# Decode one 32-bit PDO into a human-readable line.
pd_decode_one() {
    local raw=$1
    local p32=$(( raw & 0xFFFFFFFF ))
    local t=$(( (p32 >> 30) & 0x3 ))
    case $t in
        0) printf 'fixed    %6dmV %5dmA  dual_role_power=%d unconstrained_power=%d\n' \
             "$(( ((p32 >> 10) & 0x3FF) * 50 ))" "$(( (p32 & 0x3FF) * 10 ))" \
             "$(( (p32 >> 29) & 1 ))" "$(( (p32 >> 27) & 1 ))" ;;
        1) printf 'battery  %6dmV-%dmV %dmW\n' \
             "$(( ((p32 >> 10) & 0x3FF) * 50 ))" "$(( ((p32 >> 20) & 0x3FF) * 50 ))" "$(( (p32 & 0x3FF) * 250 ))" ;;
        2) printf 'variable %6dmV-%dmV %dmA\n' \
             "$(( ((p32 >> 10) & 0x3FF) * 50 ))" "$(( ((p32 >> 20) & 0x3FF) * 50 ))" "$(( (p32 & 0x3FF) * 10 ))" ;;
        3) printf 'pps      %6dmV-%dmV %dmA\n' \
             "$(( ((p32 >> 8) & 0xFF) * 100 ))" "$(( ((p32 >> 17) & 0xFF) * 100 ))" "$(( (p32 & 0x7F) * 50 ))" ;;
    esac
}

pd_decode_all() {
    local p
    IFS=, read -ra _pdos <<< "${1:-}"
    for p in "${_pdos[@]:-}"; do
        [ -n "$p" ] && [ "$p" != "0" ] && pd_decode_one "$p"
    done
}

# Per USB-PD spec the capability flags live in the first (vSafe5V fixed) PDO.
# bit 29 Dual-Role Power, bit 27 Unconstrained Power.
# Prints "<dual_role> <unconstrained>", or nothing if there are no PDOs.
pd_flags() {
    local list="${1:-}" first p32
    first="${list%%,*}"
    [ -n "$first" ] && [ "$first" != "0" ] || return 1
    p32=$(( first & 0xFFFFFFFF ))
    [ $(( (p32 >> 30) & 0x3 )) -eq 0 ] || return 1   # must be a Fixed Supply PDO
    printf '%d %d' "$(( (p32 >> 29) & 1 ))" "$(( (p32 >> 27) & 1 ))"
}

# --- USB-PD Discover Identity -------------------------------------------------
#
# The source's own VID/PID, from its Discover Identity response. Lives on the SOP
# node (SOP = the attached port partner; SOP' would be the cable's e-marker, a
# different device entirely). This node exists only while a source is attached,
# so unlike PortControllerPortPDO it does not go stale.

pd_identity_raw() {
    ioreg -rc IOPortTransportComponentCCUSBPDSOP -w 0 2>/dev/null | grep -m1 '"Metadata"'
}

# Prints "vid:pid" in lowercase hex, or fails when the source answers no identity.
pd_device_id() {
    local meta="${1:-}" vid pid
    vid="$(printf '%s' "$meta" | adapter_field 'Vendor ID')"
    pid="$(printf '%s' "$meta" | adapter_field 'Product ID')"
    [ -n "$vid" ] && [ -n "$pid" ] || return 1
    printf '%04x:%04x' "$vid" "$pid"
}

# Decode the ID Header VDO product-type fields, for `identify` output only.
# ioreg prints VDO bytes little-endian, e.g. <b4048019> is 0x198004b4.
pd_id_header() {
    local meta="${1:-}" le v
    le="$(printf '%s' "$meta" | sed -n 's/.*"VDOs"=(<\([0-9a-f]*\)>.*/\1/p')"
    [ ${#le} -eq 8 ] || return 1
    v=$(( 0x${le:6:2}${le:4:2}${le:2:2}${le:0:2} ))
    printf 'ufp_product_type=%d dfp_product_type=%d modal=%d usb_host=%d usb_device=%d' \
        "$(( (v >> 27) & 7 ))" "$(( (v >> 23) & 7 ))" "$(( (v >> 26) & 1 ))" \
        "$(( (v >> 31) & 1 ))" "$(( (v >> 30) & 1 ))"
}

# Identity: the full advertised capability set, which differs between two
# same-wattage sources far more reliably than wattage alone.
pd_pdo_hash() {
    local list="${1:-}"
    [ -n "$list" ] || return 1
    printf '%s' "$list" | tr -d ' ' | md5 -q 2>/dev/null | cut -c1-12
}

adapter_fingerprint() {
    local d="${1:-}" pdo="${2:-}" watts sn hash
    watts="$(printf '%s' "$d" | adapter_field Watts)"
    sn="$(printf '%s' "$d" | adapter_field SerialString)"
    [ -n "$watts" ] || return 1
    hash="$(pd_pdo_hash "$pdo")" || hash="none"
    printf 'w=%s;pdo=%s;sn=%s\n' "$watts" "$hash" "$sn"
}

# --- classification -----------------------------------------------------------

in_list() {
    local fp="$1" entry
    while IFS= read -r entry; do
        entry="${entry// /}"
        [ -n "$entry" ] || continue
        [ "$entry" = "$fp" ] && return 0
    done <<< "$2"
    return 1
}

# 0 = power bank, 1 = not. Echoes the reason on stdout.
# Precedence: explicit device id, then explicit fingerprint, then inferred bits.
# Explicit always wins - real devices misreport the inferred fields.
classify() {
    local fp="$1" dev="$2" watts="$3" flags="$4" drp unc

    if [ -n "$dev" ]; then
        if in_list "$dev" "$WALL_DEVICES"; then echo "device $dev listed as wall charger"; return 1; fi
        if in_list "$dev" "$BANK_DEVICES"; then echo "device $dev listed as power bank"; return 0; fi
    fi
    if in_list "$fp" "$WALL_FINGERPRINTS"; then echo "fingerprint listed as wall charger"; return 1; fi
    if in_list "$fp" "$BANK_FINGERPRINTS"; then echo "fingerprint listed as power bank"; return 0; fi

    if [ "$USE_PD_UNCONSTRAINED" = "1" ] && [ -n "$flags" ]; then
        drp="${flags%% *}"; unc="${flags##* }"
        if [ "$unc" = "0" ]; then
            if [ "$REQUIRE_DUAL_ROLE" = "1" ] && [ "$drp" != "1" ]; then
                echo "unconstrained_power=0 but no dual-role power; REQUIRE_DUAL_ROLE=1"
                return 1
            fi
            echo "USB-PD unconstrained_power=0 (battery-backed source)"
            return 0
        fi
        echo "USB-PD unconstrained_power=1 (mains-backed source)"
        return 1
    fi

    if [ -n "$BANK_MAX_WATTS" ] && [ -n "$watts" ] && [ "$watts" -le "$BANK_MAX_WATTS" ] 2>/dev/null; then
        echo "wattage fallback: ${watts}W <= ${BANK_MAX_WATTS}W"
        return 0
    fi
    echo "unrecognised source - add ${dev:-$fp} to BANK_DEVICES or WALL_DEVICES"
    return 1
}

# --- Low Power Mode -----------------------------------------------------------
#
# Asymmetric on purpose: the WRITE key is `lowpowermode`, but macOS 26 reports it
# back as `powermode` in `pmset -g custom`. Matching only /lowpowermode/ on read
# silently never matches.
# Second asymmetry: pmset OMITS the key entirely when the mode is off. Absent
# therefore means 0, not "unsupported" — treating absent as unknown makes every
# save/restore decision wrong.
lpm_current() {
    local v
    v="$(pmset -g custom 2>/dev/null |
        awk '$1 == "powermode" || $1 == "lowpowermode" { print $2; exit }')"
    printf '%s' "${v:-0}"
}

lpm_set() {
    local want="$1" have
    [ -n "$want" ] || return 0
    have="$(lpm_current)"
    [ "$have" = "$want" ] && return 0
    pmset -a lowpowermode "$want" || { log "pmset -a lowpowermode $want FAILED"; return 1; }
    log "low power mode ${have:-?} -> $want"
}

state_save() { [ -f "$STATE" ] || printf '%s\n' "$(lpm_current)" > "$STATE" 2>/dev/null; }
# Defaults to 0 when nothing was saved, or the saved value was empty — never "".
state_restore_value() {
    local v=""
    [ -f "$STATE" ] && v="$(head -1 "$STATE")"
    printf '%s' "${v:-0}"
}
state_clear() { rm -f "$STATE" 2>/dev/null; }

# --- the decision -------------------------------------------------------------

apply() {
    local raw pdo flags fp dev watts reason

    if ! on_ac; then
        case "$ON_BATTERY" in
            on)     state_save; lpm_set 1 ;;
            off)    lpm_set 0; state_clear ;;
            ignore) lpm_set "$(state_restore_value)"; state_clear ;;
        esac
        return
    fi

    raw="$(adapter_raw)"
    pdo="$(pd_pdo_list "$(pd_port_line)")"
    flags="$(pd_flags "$pdo")" || flags=""
    watts="$(printf '%s' "$raw" | adapter_field Watts)"
    fp="$(adapter_fingerprint "$raw" "$pdo")" || fp="unknown"
    dev="$(pd_device_id "$(pd_identity_raw)")" || dev=""

    if reason="$(classify "$fp" "$dev" "$watts" "$flags")"; then
        log "power bank: ${dev:-$fp} — $reason"
        state_save
        lpm_set 1
    else
        log "wall power: ${dev:-$fp} — $reason"
        lpm_set "$(state_restore_value)"
        state_clear
    fi
}

# --- subcommands --------------------------------------------------------------

cmd_watch() {
    apply
    # pslog emits a line on every AC<->battery transition. PD contract details
    # settle a moment after attach, so let the port controller finish negotiating.
    pmset -g pslog 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            *"Now drawing from"*) sleep 2; apply ;;
        esac
    done
    log "pslog stream ended; exiting for launchd to restart"
    exit 1
}

cmd_identify() {
    local raw pdo flags fp meta dev reason rc
    if ! on_ac; then
        echo "Not running on AC — plug the source in and run this again." >&2
        echo "(PD capability data persists from the last negotiation and would be stale.)" >&2
        return 1
    fi
    raw="$(adapter_raw)"
    pdo="$(pd_pdo_list "$(pd_port_line)")"
    flags="$(pd_flags "$pdo")" || flags=""
    fp="$(adapter_fingerprint "$raw" "$pdo")" || { echo "No adapter details available." >&2; return 1; }
    meta="$(pd_identity_raw)"
    dev="$(pd_device_id "$meta")" || dev=""

    echo "Attached source:"
    echo "  device id:   ${dev:-none (no Discover Identity response)}"
    echo "  watts:       $(printf '%s' "$raw" | adapter_field Watts)"
    echo "  description: $(printf '%s' "$raw" | adapter_field Description)"
    echo "  serial:      $(printf '%s' "$raw" | adapter_field SerialString)"
    echo "  fingerprint: $fp"
    [ -n "$meta" ] && echo "  id header:   $(pd_id_header "$meta" || echo 'undecodable')"
    echo
    if [ -n "$pdo" ]; then
        echo "Advertised USB-PD source capabilities:"
        pd_decode_all "$pdo" | sed 's/^/  /'
        echo
    fi
    reason="$(classify "$fp" "$dev" "$(printf '%s' "$raw" | adapter_field Watts)" "$flags")"; rc=$?
    echo "  verdict: $reason"
    [ $rc -eq 0 ] && echo "  => POWER BANK" || echo "  => WALL POWER"
    echo
    if [ -n "$dev" ]; then
        echo "To classify this source, add to $CONFIG:"
        echo "  BANK_DEVICES=\"$dev\"     # or WALL_DEVICES"
    else
        echo "This source answers no Discover Identity. Use the fingerprint instead:"
        echo "  BANK_FINGERPRINTS=\"$fp\"     # or WALL_FINGERPRINTS"
    fi
}

cmd_status() {
    local raw pdo fp lpm
    raw="$(adapter_raw)"
    pdo="$(pd_pdo_list "$(pd_port_line)")"
    fp="$(adapter_fingerprint "$raw" "$pdo" 2>/dev/null)" || fp=""
    lpm="$(lpm_current)"
    echo "power source:    $(on_ac && echo 'AC Power' || echo 'Battery Power')"
    echo "device id:       $(pd_device_id "$(pd_identity_raw)" 2>/dev/null || echo none)"
    echo "source:          ${fp:-none}"
    echo "pd contract:     ${pdo:-none (no live contract)}"
    echo "low power mode:  $lpm"
    echo "saved state:     $([ -f "$STATE" ] && head -1 "$STATE" || echo 'none')"
    echo "config:          $CONFIG $([ -f "$CONFIG" ] || echo '(missing)')"
    launchctl print "system/$LABEL" >/dev/null 2>&1 &&
        echo "daemon:          loaded" || echo "daemon:          not loaded"
}

cmd_doctor() {
    local rc=0 v
    printf 'pmset present:            '
    command -v pmset >/dev/null && echo ok || { echo MISSING; rc=1; }

    printf 'AdapterDetails readable:  '
    ioreg -rn AppleSmartBattery >/dev/null 2>&1 && echo ok || { echo FAIL; rc=1; }

    printf 'low power mode:           '
    v="$(lpm_current)"
    echo "currently $v (write key: lowpowermode, read key: powermode)"

    printf 'PD capabilities visible:  '
    if [ -n "$(pd_pdo_list "$(pd_port_line)")" ]; then echo ok
    elif on_ac; then echo "none — attached source has no live PD contract; use fingerprints"; rc=2
    else echo "n/a (on battery — re-run on AC)"; fi

    printf 'pre-existing LPM state:   '
    if [ "$v" != "0" ] && [ -n "$v" ] && [ ! -f "$STATE" ]; then
        echo "WARNING: Low Power Mode is currently ON ($v)."
        echo "                          That value will be saved as your 'normal' setting and"
        echo "                          restored whenever a power bank is NOT attached."
        echo "                          Set it to what you want as normal first:"
        echo "                            sudo pmset -a lowpowermode 0"
        rc=2
    else echo ok; fi

    printf 'running as root:          '
    [ "$(id -u)" -eq 0 ] && echo yes || echo "no (writes will fail; the daemon runs as root)"
    return $rc
}

usage() {
    cat <<USAGE
powerbank-lpm $VERSION

  identify   Decode the attached source's USB-PD capabilities and fingerprint
  status     Power source, PD contract, Low Power Mode, daemon state
  doctor     Check platform support before installing
  watch      Event loop (this is what the LaunchDaemon runs)

Config: $CONFIG
USAGE
}

[ -f "$CONFIG" ] && . "$CONFIG"

# Allow tests to source the pure functions without dispatching.
[ -n "${POWERBANK_LPM_LIB:-}" ] && return 0

case "${1:-}" in
    watch)    cmd_watch ;;
    identify) cmd_identify ;;
    status)   cmd_status ;;
    doctor)   cmd_doctor ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $1" >&2; usage >&2; exit 64 ;;
esac
